---
import Base from '../layouts/Base.astro';

// Things I've built and put online. Add new entries here.
const projects = [
  {
    name: 'School Lines',
    href: '/school-lines/',
    tag: 'interactive',
    dek: 'School systems around the world drawn as metro-map lines on a shared age axis, so 38 countries can be compared by stage, fares and attainment.',
  },
];
---

<Base title="Projects — Tian de Klerk">
  <section class="hero">
    <h1>Things I've built.</h1>
    <p class="sub">Small tools and experiments that ended up online.</p>
  </section>

  <p class="section-label">Projects</p>

  {
    projects.map((p) => (
      <a class="project" href={p.href}>
        <div class="meta">
          <span class="tag">{p.tag}</span>
        </div>
        <h2>{p.name}</h2>
        <p class="dek">{p.dek}</p>
      </a>
    ))
  }
</Base>

<style>
  .hero { padding: 64px 0 48px; }
  .hero h1 {
    font-family: 'JetBrains Mono', monospace; font-weight: 800;
    font-size: clamp(32px, 6vw, 50px); line-height: 1.06; letter-spacing: -0.04em;
    text-transform: lowercase;
  }
  .hero .sub { margin-top: 20px; color: var(--ink-soft); font-size: 18px; max-width: 52ch; }

  .section-label {
    font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 0.12em;
    color: var(--ink-soft); text-transform: uppercase; margin: 56px 0 4px;
  }

  .project {
    display: block; padding: 26px 0 26px 18px; border-top: 1px solid var(--line);
    text-decoration: none; position: relative;
  }
  .project::before {
    content: ''; position: absolute; left: 0; top: 26px; height: 22px;
    width: 4px; border-radius: 2px; background: var(--accent);
    transition: height 0.18s ease;
  }
  .project:hover::before { height: calc(100% - 52px); }
  .project .meta {
    font-family: 'JetBrains Mono', monospace; font-size: 11.5px; color: var(--ink-soft);
    display: flex; gap: 14px; margin-bottom: 10px; flex-wrap: wrap; align-items: center;
  }
  .project .tag {
    color: var(--accent); border: 1px solid var(--accent); border-radius: 4px;
    padding: 1px 6px; font-size: 10.5px; letter-spacing: 0.04em;
  }
  .project h2 {
    font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 24px;
    line-height: 1.24; letter-spacing: -0.03em;
  }
  .project:hover h2 { color: var(--accent); }
  .project .dek { margin-top: 9px; color: var(--ink-soft); font-size: 16px; max-width: 64ch; }

  @media (max-width: 720px) {
    .hero { padding: 46px 0 36px; }
    .project h2 { font-size: 23px; }
  }
</style>
